# Public site origin, used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://unbusylabs.com

# Displayed contact email and social links (footer, structured data).
NEXT_PUBLIC_CONTACT_EMAIL=hello@unbusylabs.com
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Optional: connect Resend (https://resend.com) to send real enquiry emails.
# Without this, submissions are logged server-side in a safe dev-mode handler.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=hello@unbusylabs.com
